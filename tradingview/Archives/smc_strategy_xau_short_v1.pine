// ============================================================
// SMC Strategy XAU Short Only v1
// Projet   : SMC Trading Bot
// Version  : XAU-SHORT 1.0.0
// ============================================================
//
// BASE : XAU v1 — VERSION SHORT UNIQUEMENT
//
// RATIONNEL :
//   Reversals institutionnels détectés par CHoCH après sweep
//   de niveau premium (PDH / Asian High uniquement).
//   RR observé ~13.44 sur les shorts gagnants → objectif RR 4
//   avec breakeven winrate à 20%.
//
// CONDITIONS SHORT (8 OBLIGATOIRES) :
//   1. Daily close < EMA 50 Daily (biais BEAR)
//   2. close < EMA 50 4H
//   3. Session : London 07-12h UTC ou NY 13h30-17h UTC
//   4. Sweep HIGH qualité >= 2 (PDH q=3 ou Asian High q=2 UNIQUEMENT)
//   5. CHoCH Bear confirmé
//   6. ATR >= 90% moyenne (filtre jours plats)
//   7. Prix dans FVG baissier OU OB baissier actif
//   8. Pas de position ouverte
//
// SL   : sweep_high + 5 pips | clamp 25-80 pips | skip si > 80
// TP   : PDL > ASR Low > Pivot Low > fallback RR × 4
// TRAIL: après +2R → déplace SL à entry - 1R (lock +1R)
// SIZE : floor(risk_usd / (sl_pips × 0.10)) → clamp 1-20 oz
// ============================================================

//@version=6
strategy(
     title                   = "SMC XAU Short Only v1",
     shorttitle              = "XAU-S v1",
     overlay                 = true,
     initial_capital         = 3000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     commission_type         = strategy.commission.cash_per_order,
     commission_value        = 0.40,
     slippage                = 2,
     process_orders_on_close = true,
     max_bars_back           = 500,
     pyramiding              = 0,
     margin_long             = 5.0,
     margin_short            = 5.0
 )

// ============================================================
// SECTION 1 — PARAMÈTRES CONFIGURABLES
// ============================================================

var string GRP_SWEEP   = "Sweep & Structure"
var string GRP_FVG     = "Fair Value Gap"
var string GRP_OB      = "Order Block Bear"
var string GRP_RISK    = "Gestion du risque"
var string GRP_ATR     = "Filtre ATR"
var string GRP_INST    = "Niveaux Institutionnels"
var string GRP_DISPLAY = "Affichage"

sweep_lookback = input.int(
     30, title="Lookback sweep récent (bougies)",
     minval=5, maxval=60, group=GRP_SWEEP)

struct_lookback = input.int(
     15, title="Lookback CHoCH (bougies)",
     minval=5, maxval=50, group=GRP_SWEEP,
     tooltip="Fenêtre pour détecter le break de structure baissier")

swing_lookback = input.int(
     10, title="Lookback pivot swing",
     minval=3, maxval=50, group=GRP_SWEEP)

sweep_buffer_pips = input.float(
     2.0, title="Buffer sweep (pips)",
     minval=0.5, maxval=10.0, step=0.5, group=GRP_SWEEP)

fvg_atr_mult = input.float(
     1.5, title="Multiplicateur ATR impulsion FVG",
     minval=0.5, maxval=5.0, step=0.1, group=GRP_FVG)

ob_lookback = input.int(
     15, title="Lookback Order Block baissier (bougies)",
     minval=3, maxval=40, group=GRP_OB)

ob_body_atr_mult = input.float(
     0.5, title="Corps OB minimum (x ATR)",
     minval=0.1, maxval=2.0, step=0.1, group=GRP_OB)

min_rr_short = input.float(
     4.0, title="RR minimum short",
     minval=2.0, maxval=10.0, step=0.5, group=GRP_RISK,
     tooltip="Breakeven : winrate > 20% à RR 4. RR 13.44 observé sur XAU CHoCH gagnants.")

sl_min_pips = input.float(
     25.0, title="SL minimum (pips)",
     minval=10.0, maxval=50.0, step=1.0, group=GRP_RISK)

sl_max_pips = input.float(
     80.0, title="SL maximum (pips) — skip si dépassé",
     minval=30.0, maxval=150.0, step=1.0, group=GRP_RISK)

risk_usd = input.float(
     20.0, title="Risque par trade (USD)",
     minval=5.0, maxval=200.0, step=5.0, group=GRP_RISK)

use_trailing = input.bool(
     true, title="Trailing stop actif après +2R (lock +1R)",
     group=GRP_RISK,
     tooltip="Quand profit >= 2R : déplace SL à entry - 1R pour sécuriser au moins 1R.")

atr_mult_filter = input.float(
     0.9, title="ATR min (x moyenne — filtre jours plats)",
     minval=0.5, maxval=1.5, step=0.05, group=GRP_ATR,
     tooltip="Trade uniquement si ATR actuel >= X × ATR moyen. Évite le bruit des sessions plates.")

atr_avg_period = input.int(
     50, title="Période moyenne ATR",
     minval=10, maxval=200, group=GRP_ATR)

show_pdhl      = input.bool(true,  title="Afficher PDH / PDL",         group=GRP_INST)
show_asr       = input.bool(true,  title="Afficher Asian Range",        group=GRP_INST)
show_ema       = input.bool(true,  title="EMA 50 (4H)",                group=GRP_DISPLAY)
show_swings    = input.bool(true,  title="Niveaux swing",               group=GRP_DISPLAY)
show_fvg       = input.bool(true,  title="Zones FVG",                  group=GRP_DISPLAY)
show_ob        = input.bool(true,  title="Zones OB baissier",           group=GRP_DISPLAY)
show_choch     = input.bool(true,  title="Lignes CHoCH",                group=GRP_DISPLAY)
show_labels    = input.bool(true,  title="Labels signaux",              group=GRP_DISPLAY)
show_table     = input.bool(true,  title="Tableau récapitulatif",       group=GRP_DISPLAY)

// ============================================================
// SECTION 2 — UTILITAIRES
// ============================================================

PIP = syminfo.mintick * 10

f_pips_to_price(pips) =>
    pips * PIP

f_price_to_pips(price_diff) =>
    math.round(math.abs(price_diff) / PIP, 1)

f_clamp(val, lo, hi) =>
    math.max(lo, math.min(hi, val))

// Session SHORT : London 07-12h UTC + NY 13h30-17h UTC
// Évite l'entre-deux 12h-13h30 (Gold peu liquide)
f_in_session() =>
    h             = hour(time, "UTC")
    m             = minute(time, "UTC")
    total_minutes = h * 60 + m
    london = total_minutes >= 7 * 60 and total_minutes < 12 * 60
    ny     = total_minutes >= 13 * 60 + 30 and total_minutes < 17 * 60
    london or ny

f_in_asian_session() =>
    h             = hour(time, "UTC")
    m             = minute(time, "UTC")
    total_minutes = h * 60 + m
    total_minutes >= 0 and total_minutes < 7 * 60

// XAUUSD : 1 oz = 1 unité, 1 pip = 0.10 $ par oz
// margin_short=5% → ex. 5 oz × 3300$ × 5% = 825$ marge ✓
pip_value_per_unit = 0.10

f_qty(sl_pips) =>
    math.max(1.0, math.min(20.0,
        math.floor(risk_usd / (sl_pips * pip_value_per_unit))))

// ============================================================
// SECTION 3 — FILTRE ATR
// ============================================================

atr_current = ta.atr(14)
atr_avg     = ta.sma(atr_current, atr_avg_period)
atr_ok      = atr_current >= atr_avg * atr_mult_filter
atr_14      = atr_current

// ============================================================
// SECTION 4 — EMA 50 4H + BIAIS DAILY
// ============================================================

ema_50_4h = request.security(
     syminfo.tickerid, "240",
     ta.ema(close, 50),
     lookahead=barmerge.lookahead_off)

close_daily  = request.security(syminfo.tickerid, "D", close,             lookahead=barmerge.lookahead_off)
ema_50_daily = request.security(syminfo.tickerid, "D", ta.ema(close, 50), lookahead=barmerge.lookahead_off)

daily_bias_bear = close_daily < ema_50_daily

plot(show_ema ? ema_50_4h : na,
     title="EMA 50 (4H)", color=color.new(color.orange, 0), linewidth=2)

highest_10 = ta.highest(high, 10)

if barstate.islast
    label.new(bar_index, highest_10,
         text      = daily_bias_bear ? "BIAS D: BEAR" : "BIAS D: BULL",
         style     = label.style_label_left,
         color     = daily_bias_bear ? color.new(color.red, 10) : color.new(color.gray, 40),
         textcolor = color.white,
         size      = size.normal)

// ============================================================
// SECTION 5 — NIVEAUX INSTITUTIONNELS (PDH / PDL)
// ============================================================

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)

if show_pdhl and barstate.islast
    line.new(bar_index - 50, pdh, bar_index + 5, pdh,
         color=color.white, style=line.style_dotted, width=2)
    label.new(bar_index + 5, pdh, text="PDH",
         style=label.style_label_left, color=color.new(color.white, 30),
         textcolor=color.white, size=size.tiny)
    line.new(bar_index - 50, pdl, bar_index + 5, pdl,
         color=color.white, style=line.style_dotted, width=2)
    label.new(bar_index + 5, pdl, text="PDL",
         style=label.style_label_left, color=color.new(color.white, 30),
         textcolor=color.white, size=size.tiny)

// ============================================================
// SECTION 6 — ASIAN SESSION RANGE (ASR)
// ============================================================

var float asian_high_track  = na
var float asian_low_track   = na
var float asian_high_prev   = na
var float asian_low_prev    = na
var int   asian_session_day = na

current_day = dayofweek(time)
is_asian    = f_in_asian_session()

if is_asian
    if na(asian_session_day) or asian_session_day != current_day
        asian_session_day := current_day
        asian_high_track  := high
        asian_low_track   := low
    else
        if high > asian_high_track
            asian_high_track := high
        if low < asian_low_track
            asian_low_track := low

if not is_asian and not na(asian_high_track)
    asian_high_prev := asian_high_track
    asian_low_prev  := asian_low_track

asr_high = asian_high_prev
asr_low  = asian_low_prev

if show_asr and barstate.islast and not na(asr_high) and not na(asr_low)
    box.new(bar_index - 50, asr_high, bar_index + 5, asr_low,
         border_color=color.new(color.gray, 50),
         bgcolor=color.new(color.gray, 88), border_width=1)
    label.new(bar_index - 25, asr_high, text="ASR H",
         style=label.style_none, textcolor=color.new(color.gray, 30), size=size.tiny)
    label.new(bar_index - 25, asr_low, text="ASR L",
         style=label.style_none, textcolor=color.new(color.gray, 30), size=size.tiny)

// ============================================================
// SECTION 7 — SWING HIGHS / LOWS
// ============================================================

raw_swing_high = ta.pivothigh(high, swing_lookback, swing_lookback)
raw_swing_low  = ta.pivotlow(low,   swing_lookback, swing_lookback)

var float last_swing_high = na
var float last_swing_low  = na

if not na(raw_swing_high)
    last_swing_high := raw_swing_high
if not na(raw_swing_low)
    last_swing_low := raw_swing_low

if show_swings and not na(raw_swing_high)
    line.new(bar_index - swing_lookback, raw_swing_high, bar_index, raw_swing_high,
         color=color.new(color.red, 50), style=line.style_dotted, width=1)

if show_swings and not na(raw_swing_low)
    line.new(bar_index - swing_lookback, raw_swing_low, bar_index, raw_swing_low,
         color=color.new(color.green, 50), style=line.style_dotted, width=1)

// ============================================================
// SECTION 8 — SWEEP BEAR (qualité 2+ : PDH ou ASR High uniquement)
// ============================================================
// Le sweep swing générique (q=1) est EXCLU — trop de faux signaux
// sur Gold où chaque mini-spike peut casser un swing

sweep_buffer = f_pips_to_price(sweep_buffer_pips)

f_sweep_bear_quality() =>
    q = 0
    if not na(pdh) and high > pdh + sweep_buffer and close < pdh and close < open
        q := 3   // PDH institutionnel — niveau premium quotidien
    else if not na(asr_high) and high > asr_high + sweep_buffer and close < asr_high and close < open
        q := 2   // Asian Session High — range institutionnel nocturne
    q              // sweep swing q=1 exclu volontairement

sweep_bear_quality_now = f_sweep_bear_quality()
sweep_high_cond = sweep_bear_quality_now >= 2 and daily_bias_bear

var float last_sweep_high_price = na
var int   last_sweep_high_q     = 0

if sweep_high_cond
    last_sweep_high_price := high
    last_sweep_high_q     := sweep_bear_quality_now

sweep_high_recent = ta.barssince(sweep_high_cond) <= sweep_lookback
     and last_sweep_high_q >= 2

// ============================================================
// SECTION 9 — CHoCH BEAR
// ============================================================

struct_ref_low = ta.lowest(low, struct_lookback)[1]

choch_bear = sweep_high_recent
     and close < struct_ref_low
     and close[1] >= struct_ref_low
     and daily_bias_bear

if choch_bear and show_choch
    line.new(bar_index - 1, struct_ref_low, bar_index, struct_ref_low,
         color=color.new(color.red, 20), style=line.style_dashed, width=2)
    if show_labels
        label.new(bar_index, high, text="CHoCH ▼",
             style=label.style_label_down,
             color=color.new(color.red, 10), textcolor=color.white, size=size.small)

// ============================================================
// SECTION 10 — FAIR VALUE GAP (FVG)
// ============================================================
// Bear FVG : arrays pour signal | Bull FVG : affichage seulement

fvg_impulse  = (high[1] - low[1]) > fvg_atr_mult * atr_14
fvg_bull_new = fvg_impulse and high[2] < low[0]
fvg_bear_new = fvg_impulse and low[2]  > high[0]

var float[] fvg_bear_top = array.new_float(3, na)
var float[] fvg_bear_bot = array.new_float(3, na)

if fvg_bear_new
    array.set(fvg_bear_top, 2, array.get(fvg_bear_top, 1))
    array.set(fvg_bear_bot, 2, array.get(fvg_bear_bot, 1))
    array.set(fvg_bear_top, 1, array.get(fvg_bear_top, 0))
    array.set(fvg_bear_bot, 1, array.get(fvg_bear_bot, 0))
    array.set(fvg_bear_top, 0, low[2])
    array.set(fvg_bear_bot, 0, high[0])

for i = 0 to 2
    bt = array.get(fvg_bear_top, i)
    bb = array.get(fvg_bear_bot, i)
    if not na(bt) and not na(bb) and close > bt
        array.set(fvg_bear_top, i, na)
        array.set(fvg_bear_bot, i, na)

f_price_in_bear_fvg(p) =>
    result = false
    for i = 0 to 2
        bt = array.get(fvg_bear_top, i)
        bb = array.get(fvg_bear_bot, i)
        if not na(bt) and not na(bb) and p >= bb and p <= bt
            result := true
    result

f_bear_fvg_top() =>
    result = float(na)
    for i = 0 to 2
        bt = array.get(fvg_bear_top, i)
        if not na(bt) and na(result)
            result := bt
    result

// Bull FVG — affichage uniquement (pas d'arrays, pas de signal)
if show_fvg and fvg_bull_new
    box.new(bar_index - 2, low[0], bar_index + 20, high[2],
         border_color=color.new(color.blue, 60), bgcolor=color.new(color.blue, 85), border_width=1)
    if show_labels
        label.new(bar_index, (low[0] + high[2]) / 2, text="FVG",
             style=label.style_none, textcolor=color.new(color.blue, 20), size=size.tiny)

if show_fvg and fvg_bear_new
    box.new(bar_index - 2, low[2], bar_index + 20, high[0],
         border_color=color.new(color.orange, 60), bgcolor=color.new(color.orange, 80), border_width=1)
    if show_labels
        label.new(bar_index, (low[2] + high[0]) / 2, text="FVG",
             style=label.style_none, textcolor=color.new(color.orange, 20), size=size.tiny)

// ============================================================
// SECTION 11 — ORDER BLOCK BAISSIER
// ============================================================

var float[] ob_bear_top = array.new_float(3, na)
var float[] ob_bear_bot = array.new_float(3, na)

f_last_bull_candle_inst() =>
    o_val = float(na)
    c_val = float(na)
    for i = 1 to ob_lookback
        body = math.abs(close[i] - open[i])
        if close[i] > open[i] and body > ob_body_atr_mult * atr_14[i]
            o_val := open[i]
            c_val := close[i]
            break
    [o_val, c_val]

if choch_bear
    [ob_open, ob_close] = f_last_bull_candle_inst()
    if not na(ob_open) and not na(ob_close)
        array.set(ob_bear_top, 2, array.get(ob_bear_top, 1))
        array.set(ob_bear_bot, 2, array.get(ob_bear_bot, 1))
        array.set(ob_bear_top, 1, array.get(ob_bear_top, 0))
        array.set(ob_bear_bot, 1, array.get(ob_bear_bot, 0))
        array.set(ob_bear_top, 0, ob_close)
        array.set(ob_bear_bot, 0, ob_open)

for i = 0 to 2
    bt = array.get(ob_bear_top, i)
    bb = array.get(ob_bear_bot, i)
    if not na(bt) and not na(bb) and close > bt
        array.set(ob_bear_top, i, na)
        array.set(ob_bear_bot, i, na)

f_price_in_bear_ob(p) =>
    result = false
    for i = 0 to 2
        bt = array.get(ob_bear_top, i)
        bb = array.get(ob_bear_bot, i)
        if not na(bt) and not na(bb) and p >= bb and p <= bt
            result := true
    result

if show_ob and choch_bear
    ob_t = array.get(ob_bear_top, 0)
    ob_b = array.get(ob_bear_bot, 0)
    if not na(ob_t) and not na(ob_b)
        box.new(bar_index - ob_lookback, ob_t, bar_index + 30, ob_b,
             border_color=color.new(color.red, 40), bgcolor=color.new(color.red, 75), border_width=1)
        if show_labels
            label.new(bar_index, (ob_t + ob_b) / 2, text="OB",
                 style=label.style_none, textcolor=color.new(color.red, 20), size=size.tiny)

// ============================================================
// SECTION 12 — SIGNAL SHORT
// ============================================================

in_session   = f_in_session()
in_bear_zone = f_price_in_bear_fvg(close) or f_price_in_bear_ob(close)

short_signal = ta.barssince(choch_bear) <= sweep_lookback
     and sweep_high_recent
     and in_bear_zone
     and in_session
     and close < ema_50_4h
     and daily_bias_bear
     and atr_ok
     and strategy.position_size == 0

// ============================================================
// SECTION 13 — SL SHORT
// ============================================================
// Priorité 1 : sweep_high_price + 5 pips (niveau premium cassé)
// Fallback   : close + 30 pips
// Si SL brut > sl_max_pips → sl_short_ok = false → trade SKIP

f_sl_short_raw_pips() =>
    raw_price = close + f_pips_to_price(30.0)
    if not na(last_sweep_high_price)
        raw_price := last_sweep_high_price + f_pips_to_price(5.0)
    f_price_to_pips(raw_price - close)

sl_short_raw_pips = f_sl_short_raw_pips()
sl_short_ok       = sl_short_raw_pips >= sl_min_pips and sl_short_raw_pips <= sl_max_pips
sl_short_pips     = sl_short_raw_pips
sl_short_price    = close + f_pips_to_price(sl_short_pips)

// ============================================================
// SECTION 14 — TP SHORT (RR minimum 4.0)
// ============================================================
// Priorité : PDL → ASR Low → Pivot Low → fallback RR × 4

f_tp_short(sl_price) =>
    sl_dist  = sl_price - close
    min_dist = sl_dist * min_rr_short
    tp_tgt   = close - min_dist
    next_pl  = ta.pivotlow(low, swing_lookback, 0)
    result   = tp_tgt
    if not na(pdl) and pdl < tp_tgt
        result := pdl
    else if not na(asr_low) and asr_low < tp_tgt
        result := asr_low
    else if not na(next_pl) and next_pl < tp_tgt
        result := next_pl
    result

tp_short_price = f_tp_short(sl_short_price)

rr_short = 0.0
if sl_short_pips > 0
    rr_short := f_price_to_pips(close - tp_short_price) / sl_short_pips
rr_short_ok = rr_short >= min_rr_short

// ============================================================
// SECTION 15 — TRAILING STOP (activé après +2R)
// ============================================================
// Quand profit flottant >= 2R : déplace SL à entry - 1R
// Lock garanti de +1R même si le trade revient contre nous

var float entry_price_mem   = na
var float sl_initial_pips_m = na
var bool  trail_triggered   = false
var float tp_short_mem      = na

if strategy.position_size[1] != 0 and strategy.position_size == 0
    entry_price_mem   := na
    sl_initial_pips_m := na
    trail_triggered   := false
    tp_short_mem      := na

if strategy.position_size < 0 and use_trailing
         and not trail_triggered
         and not na(entry_price_mem)
         and not na(sl_initial_pips_m)
    profit_pips = f_price_to_pips(entry_price_mem - close)
    if profit_pips >= sl_initial_pips_m * 2.0
        trail_triggered := true
        trail_sl_price   = entry_price_mem - f_pips_to_price(sl_initial_pips_m)
        strategy.exit("Short TP/SL", from_entry="Short",
             stop  = trail_sl_price,
             limit = tp_short_mem)

// ============================================================
// SECTION 16 — ENTRÉE SHORT
// ============================================================

if short_signal and sl_short_ok and rr_short_ok
    qty_short = f_qty(sl_short_pips)
    q_label   = "ASR-H"
    if last_sweep_high_q == 3
        q_label := "PDH"
    strategy.entry("Short", strategy.short, qty=qty_short)
    strategy.exit("Short TP/SL", from_entry="Short",
         stop=sl_short_price, limit=tp_short_price)
    entry_price_mem   := close
    sl_initial_pips_m := sl_short_pips
    trail_triggered   := false
    tp_short_mem      := tp_short_price
    if show_labels
        label.new(bar_index, high,
             text  = "S [" + q_label + "]  SL:" + str.tostring(math.round(sl_short_pips, 1)) + "p  RR:" + str.tostring(math.round(rr_short, 1)),
             style = label.style_label_down,
             color = color.new(color.maroon, 10), textcolor=color.white, size=size.tiny)

// ============================================================
// SECTION 17 — TABLEAU RÉCAPITULATIF SHORT ONLY
// ============================================================

var table stats_table = table.new(
     position.top_right, 2, 10,
     bgcolor      = color.new(color.black, 20),
     border_width = 1,
     border_color = color.new(color.gray, 50)
 )

if barstate.islast and show_table
    total_trades = strategy.closedtrades
    winning      = strategy.wintrades

    winrate = 0.0
    if total_trades > 0
        winrate := math.round(winning / total_trades * 100, 1)

    gross_profit  = strategy.grossprofit
    gross_loss    = math.abs(strategy.grossloss)

    profit_factor = 0.0
    if gross_loss > 0
        profit_factor := math.round(gross_profit / gross_loss, 2)

    net_pnl = strategy.netprofit
    max_dd  = math.round(strategy.max_drawdown / strategy.initial_capital * 100, 1)

    all_prof_sum = 0.0
    all_loss_sum = 0.0
    all_wins_n   = 0
    all_loss_n   = 0

    for i = 0 to total_trades - 1
        tpnl = strategy.closedtrades.profit(i)
        if tpnl > 0
            all_wins_n   := all_wins_n + 1
            all_prof_sum := all_prof_sum + tpnl
        else
            all_loss_n   := all_loss_n + 1
            all_loss_sum := all_loss_sum + math.abs(tpnl)

    avg_win_usd = 0.0
    if all_wins_n > 0
        avg_win_usd := all_prof_sum / all_wins_n

    avg_loss_usd = 1.0
    if all_loss_n > 0
        avg_loss_usd := all_loss_sum / all_loss_n

    rr_real = 0.0
    if avg_loss_usd > 0
        rr_real := math.round(avg_win_usd / avg_loss_usd, 2)

    ev_per_trade = math.round(
         (winrate / 100.0 * avg_win_usd) - ((1.0 - winrate / 100.0) * avg_loss_usd), 2)

    col_trades = color.red
    if total_trades >= 15
        col_trades := color.green
    else if total_trades >= 5
        col_trades := color.yellow

    col_wr = color.red
    if winrate >= 25
        col_wr := color.green
    else if winrate >= 20
        col_wr := color.yellow

    col_pf = color.red
    if profit_factor >= 1.3
        col_pf := color.green
    else if profit_factor >= 1.0
        col_pf := color.yellow

    col_rr = color.red
    if rr_real >= 4.0
        col_rr := color.green
    else if rr_real >= 2.0
        col_rr := color.yellow

    col_ev = color.red
    if ev_per_trade > 0
        col_ev := color.green

    col_pnl = color.red
    if net_pnl >= 0
        col_pnl := color.green

    col_dd = color.red
    if max_dd <= 15
        col_dd := color.green
    else if max_dd <= 25
        col_dd := color.yellow

    col_atr = color.red
    if atr_ok
        col_atr := color.green

    col_bias = color.red
    if daily_bias_bear
        col_bias := color.green

    ev_prefix = ""
    if ev_per_trade >= 0
        ev_prefix := "+"

    pnl_prefix = ""
    if net_pnl >= 0
        pnl_prefix := "+"

    atr_text = "NON"
    if atr_ok
        atr_text := "OUI"

    bias_text = "BULL ▲"
    if daily_bias_bear
        bias_text := "BEAR ▼"

    // Row 0 — Header
    table.cell(stats_table, 0, 0, "XAU Short Only v1",
         text_color=color.new(color.red, 10), text_halign=text.align_left,
         bgcolor=color.new(color.navy, 20), text_size=size.small)
    table.cell(stats_table, 1, 0, "15M",
         text_color=color.white, text_halign=text.align_right,
         bgcolor=color.new(color.navy, 20), text_size=size.small)

    // Row 1 — Trades
    table.cell(stats_table, 0, 1, "Trades",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 1, str.tostring(total_trades),
         text_color=col_trades, text_halign=text.align_right, text_size=size.small)

    // Row 2 — Winrate
    table.cell(stats_table, 0, 2, "Winrate",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 2, str.tostring(winrate) + " %",
         text_color=col_wr, text_halign=text.align_right, text_size=size.small)

    // Row 3 — Profit Factor
    table.cell(stats_table, 0, 3, "Profit Factor",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 3, str.tostring(profit_factor),
         text_color=col_pf, text_halign=text.align_right, text_size=size.small)

    // Row 4 — RR moyen réalisé
    table.cell(stats_table, 0, 4, "RR moyen réalisé",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 4, "1:" + str.tostring(rr_real),
         text_color=col_rr, text_halign=text.align_right, text_size=size.small)

    // Row 5 — EV par trade
    table.cell(stats_table, 0, 5, "EV par trade",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 5, ev_prefix + str.tostring(ev_per_trade) + " $",
         text_color=col_ev, text_halign=text.align_right, text_size=size.small)

    // Row 6 — Net PnL
    table.cell(stats_table, 0, 6, "Net PnL",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 6, pnl_prefix + str.tostring(math.round(net_pnl, 2)) + " $",
         text_color=col_pnl, text_halign=text.align_right, text_size=size.small)

    // Row 7 — Max Drawdown
    table.cell(stats_table, 0, 7, "Max Drawdown",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 7, str.tostring(max_dd) + " %",
         text_color=col_dd, text_halign=text.align_right, text_size=size.small)

    // Row 8 — ATR actif
    table.cell(stats_table, 0, 8, "ATR actif",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 8, atr_text,
         text_color=col_atr, text_halign=text.align_right, text_size=size.small)

    // Row 9 — Biais Daily
    table.cell(stats_table, 0, 9, "Biais Daily",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 9, bias_text,
         text_color=col_bias, text_halign=text.align_right, text_size=size.small)
