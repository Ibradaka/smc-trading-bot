// ============================================================
// SMC Strategy v6 — CHoCH + OTE Fibonacci 0.705
// Projet   : SMC Trading Bot
// Version  : 6.0.0
// ============================================================
//
// AJUSTEMENTS vs V5 :
//   1. CHoCH (Change of Character) — premier break de structure
//      après sweep, remplace le BOS générique comme confirmation
//   2. OTE (Optimal Trade Entry) — zone Fibonacci 62%-79%
//      du move SWEEP→CHoCH, entrée uniquement dans cette zone
//   3. Confluence requise : OTE doit coïncider avec FVG ou OB
//   4. min_rr unifié à 2.5 (plus réaliste que l'asymétrie V5)
//
// CONSERVÉ DE V5 :
//   - PDH/PDL + Asian Range + sweep qualité >= 2
//   - Killzones ICT : London 07-10h / NY 12-15h UTC
//   - FVG + OB institutionnel (corps > 0.5 ATR, 3 slots)
//   - SL : sous sweep low > OB > FVG > fallback, clampé 10-30p
//   - Breakeven à +1R
//   - 1% equity, commission 0.007%, slippage 2
//
// ============================================================

//@version=6
strategy(
     title                   = "SMC Strategy v6",
     shorttitle              = "SMC-S v6",
     overlay                 = true,
     initial_capital         = 3000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 1,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.007,
     slippage                = 2,
     process_orders_on_close = true,
     max_bars_back           = 500,
     pyramiding              = 0
 )

// ============================================================
// SECTION 1 — PARAMÈTRES CONFIGURABLES
// ============================================================

var string GRP_FILTERS  = "Filtres SMC"
var string GRP_CHOCH    = "CHoCH / OTE"
var string GRP_FVG      = "Fair Value Gap"
var string GRP_OB       = "Order Block"
var string GRP_RISK     = "Gestion du risque"
var string GRP_SWING    = "Swing / Sweep"
var string GRP_INST     = "Niveaux Institutionnels"
var string GRP_DISCOUNT = "Zone Discount/Premium"
var string GRP_DISPLAY  = "Affichage"

// Sweep
sweep_lookback = input.int(
     30, title="Lookback sweep récent (bougies)",
     minval=5, maxval=60, group=GRP_FILTERS)

min_sweep_quality = input.int(
     2, title="Qualité sweep minimum (1=swing 2=Asian 3=PDH/PDL)",
     minval=1, maxval=3, group=GRP_FILTERS,
     tooltip="1=swing générique, 2=Asian Range, 3=PDH/PDL — filtre >= 2 recommandé")

sweep_buffer_pips = input.float(
     2.0, title="Buffer sweep (pips)",
     minval=0.5, maxval=10.0, step=0.5, group=GRP_SWING)

swing_lookback = input.int(
     10, title="Lookback pivot swing",
     minval=3, maxval=50, group=GRP_SWING)

// CHoCH + OTE
choch_lookback = input.int(
     15, title="Lookback CHoCH (bougies)",
     minval=5, maxval=50, group=GRP_CHOCH,
     tooltip="Fenêtre pour détecter le premier break de structure après le sweep")

ote_fib_top = input.float(
     0.62, title="OTE zone haute (Fib)",
     minval=0.5, maxval=0.75, step=0.01, group=GRP_CHOCH,
     tooltip="Retracement Fibonacci haut de la zone OTE (ICT : 0.62)")

ote_fib_bot = input.float(
     0.79, title="OTE zone basse (Fib)",
     minval=0.65, maxval=0.90, step=0.01, group=GRP_CHOCH,
     tooltip="Retracement Fibonacci bas de la zone OTE (ICT : 0.79)")

show_choch = input.bool(true, title="Afficher CHoCH",    group=GRP_CHOCH)
show_ote   = input.bool(true, title="Afficher zone OTE", group=GRP_CHOCH)

// Niveaux institutionnels
show_pdhl = input.bool(true,  title="Afficher PDH / PDL",        group=GRP_INST)
show_pwhl = input.bool(true,  title="Afficher PWH / PWL",        group=GRP_INST)
show_asr  = input.bool(true,  title="Afficher Asian Range",       group=GRP_INST)
use_pwhl  = input.bool(false, title="Inclure PWH/PWL dans sweep", group=GRP_INST)

// FVG
fvg_atr_mult = input.float(
     1.5, title="Multiplicateur ATR impulsion FVG",
     minval=0.5, maxval=5.0, step=0.1, group=GRP_FVG)

// OB
ob_lookback = input.int(
     15, title="Lookback Order Block (bougies)",
     minval=3, maxval=40, group=GRP_OB)

ob_body_atr_mult = input.float(
     0.5, title="Corps OB minimum (x ATR)",
     minval=0.1, maxval=2.0, step=0.1, group=GRP_OB)

// Risque
min_rr = input.float(
     2.5, title="RR minimum",
     minval=1.5, maxval=6.0, step=0.1, group=GRP_RISK)

sl_min_pips = input.float(
     10.0, title="SL minimum (pips)",
     minval=5.0, maxval=30.0, step=1.0, group=GRP_RISK)

sl_max_pips = input.float(
     30.0, title="SL maximum (pips)",
     minval=10.0, maxval=60.0, step=1.0, group=GRP_RISK)

use_breakeven = input.bool(
     true, title="Breakeven automatique à +1R",
     group=GRP_RISK)

// Discount/Premium
discount_period = input.int(
     50, title="Période range Discount/Premium",
     minval=20, maxval=200, group=GRP_DISCOUNT)

use_discount_filter = input.bool(
     false, title="Activer filtre Discount/Premium",
     group=GRP_DISCOUNT)

// Affichage
show_ema       = input.bool(true, title="EMA 50 (4H)",           group=GRP_DISPLAY)
show_swings    = input.bool(true, title="Niveaux swing",          group=GRP_DISPLAY)
show_fvg       = input.bool(true, title="Zones FVG",             group=GRP_DISPLAY)
show_ob        = input.bool(true, title="Zones Order Block",      group=GRP_DISPLAY)
show_discount  = input.bool(true, title="Zones Discount/Premium", group=GRP_DISPLAY)
show_bos_lines = input.bool(true, title="Lignes BOS/CHoCH",       group=GRP_DISPLAY)
show_labels    = input.bool(true, title="Labels signaux",         group=GRP_DISPLAY)
show_table     = input.bool(true, title="Tableau récapitulatif",  group=GRP_DISPLAY)

// ============================================================
// SECTION 2 — UTILITAIRES
// ============================================================

PIP = syminfo.mintick * 10

f_pips_to_price(pips) =>
    pips * PIP

f_price_to_pips(price_diff) =>
    math.round(math.abs(price_diff) / PIP, 1)

f_clamp(val, lo, hi) =>
    math.max(lo, math.min(hi, val))

// Killzones ICT : London 07-10h / NY 12-15h UTC
f_in_killzone() =>
    h             = hour(time, "UTC")
    m             = minute(time, "UTC")
    total_minutes = h * 60 + m
    london_kz     = total_minutes >= 7 * 60  and total_minutes < 10 * 60
    ny_kz         = total_minutes >= 12 * 60 and total_minutes < 15 * 60
    london_kz or ny_kz

f_in_london_kz() =>
    h             = hour(time, "UTC")
    m             = minute(time, "UTC")
    total_minutes = h * 60 + m
    total_minutes >= 7 * 60 and total_minutes < 10 * 60

f_in_asian_session() =>
    h             = hour(time, "UTC")
    m             = minute(time, "UTC")
    total_minutes = h * 60 + m
    total_minutes >= 0 and total_minutes < 7 * 60

// ============================================================
// SECTION 3 — EMA 50 4H + BIAIS DAILY
// ============================================================

ema_50_4h = request.security(
     syminfo.tickerid, "240",
     ta.ema(close, 50),
     lookahead=barmerge.lookahead_off)

close_daily  = request.security(syminfo.tickerid, "D", close,             lookahead=barmerge.lookahead_off)
ema_50_daily = request.security(syminfo.tickerid, "D", ta.ema(close, 50), lookahead=barmerge.lookahead_off)

daily_bias_bull = close_daily > ema_50_daily
daily_bias_bear = close_daily < ema_50_daily

plot(show_ema ? ema_50_4h : na,
     title="EMA 50 (4H)", color=color.new(color.orange, 0), linewidth=2)

if barstate.islast
    label.new(bar_index, ta.highest(high, 10),
         text      = daily_bias_bull ? "BIAS D: BULL" : "BIAS D: BEAR",
         style     = label.style_label_left,
         color     = daily_bias_bull ? color.new(color.green, 10) : color.new(color.red, 10),
         textcolor = color.white,
         size      = size.normal)

// ============================================================
// SECTION 4 — NIVEAUX INSTITUTIONNELS (PDH/PDL, PWH/PWL)
// ============================================================

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_off)

if show_pdhl and barstate.islast
    line.new(bar_index - 50, pdh, bar_index + 5, pdh,
         color=color.white, style=line.style_dotted, width=2)
    label.new(bar_index + 5, pdh, text="PDH",
         style=label.style_label_left, color=color.new(color.white, 30),
         textcolor=color.white, size=size.tiny)
    line.new(bar_index - 50, pdl, bar_index + 5, pdl,
         color=color.white, style=line.style_dotted, width=2)
    label.new(bar_index + 5, pdl, text="PDL",
         style=label.style_label_left, color=color.new(color.white, 30),
         textcolor=color.white, size=size.tiny)

if show_pwhl and barstate.islast
    line.new(bar_index - 100, pwh, bar_index + 5, pwh,
         color=color.new(color.silver, 40), style=line.style_dotted, width=1)
    label.new(bar_index + 5, pwh, text="PWH",
         style=label.style_label_left, color=color.new(color.gray, 50),
         textcolor=color.white, size=size.tiny)
    line.new(bar_index - 100, pwl, bar_index + 5, pwl,
         color=color.new(color.silver, 40), style=line.style_dotted, width=1)
    label.new(bar_index + 5, pwl, text="PWL",
         style=label.style_label_left, color=color.new(color.gray, 50),
         textcolor=color.white, size=size.tiny)

// ============================================================
// SECTION 5 — ASIAN SESSION RANGE (ASR)
// ============================================================

var float asian_high_track  = na
var float asian_low_track   = na
var float asian_high_prev   = na
var float asian_low_prev    = na
var int   asian_session_day = na

current_day = dayofweek(time)
is_asian    = f_in_asian_session()

if is_asian
    if na(asian_session_day) or asian_session_day != current_day
        asian_session_day := current_day
        asian_high_track  := high
        asian_low_track   := low
    else
        if high > asian_high_track
            asian_high_track := high
        if low < asian_low_track
            asian_low_track := low

if not is_asian and not na(asian_high_track)
    asian_high_prev := asian_high_track
    asian_low_prev  := asian_low_track

asr_high = asian_high_prev
asr_low  = asian_low_prev

if show_asr and barstate.islast and not na(asr_high) and not na(asr_low)
    box.new(bar_index - 50, asr_high, bar_index + 5, asr_low,
         border_color=color.new(color.gray, 50),
         bgcolor=color.new(color.gray, 88), border_width=1)
    label.new(bar_index - 25, asr_high, text="ASR H",
         style=label.style_none, textcolor=color.new(color.gray, 30), size=size.tiny)
    label.new(bar_index - 25, asr_low, text="ASR L",
         style=label.style_none, textcolor=color.new(color.gray, 30), size=size.tiny)

// ============================================================
// SECTION 6 — ZONE DISCOUNT / PREMIUM (ICT)
// ============================================================

range_high = ta.highest(high, discount_period)
range_low  = ta.lowest(low,  discount_period)
midpoint   = (range_high + range_low) / 2.0

in_discount = close < midpoint
in_premium  = close > midpoint

if show_discount and barstate.islast
    box.new(bar_index - discount_period, range_low, bar_index + 5, midpoint,
         border_color=color.new(color.green, 80), bgcolor=color.new(color.green, 93), border_width=1)
    box.new(bar_index - discount_period, midpoint, bar_index + 5, range_high,
         border_color=color.new(color.red, 80), bgcolor=color.new(color.red, 93), border_width=1)

// ============================================================
// SECTION 7 — SWING HIGHS / LOWS
// ============================================================

atr_14 = ta.atr(14)

raw_swing_high = ta.pivothigh(high, swing_lookback, swing_lookback)
raw_swing_low  = ta.pivotlow(low,   swing_lookback, swing_lookback)

var float last_swing_high = na
var float last_swing_low  = na

if not na(raw_swing_high)
    last_swing_high := raw_swing_high
if not na(raw_swing_low)
    last_swing_low := raw_swing_low

if show_swings and not na(raw_swing_high)
    line.new(bar_index - swing_lookback, raw_swing_high, bar_index, raw_swing_high,
         color=color.new(color.red, 50), style=line.style_dotted, width=1)

if show_swings and not na(raw_swing_low)
    line.new(bar_index - swing_lookback, raw_swing_low, bar_index, raw_swing_low,
         color=color.new(color.green, 50), style=line.style_dotted, width=1)

// ============================================================
// SECTION 8 — SWEEP INSTITUTIONNEL (qualité 1/2/3)
// ============================================================

sweep_buffer = f_pips_to_price(sweep_buffer_pips)

f_sweep_bull_quality() =>
    q = 0
    if not na(pdl) and low < pdl - sweep_buffer and close > pdl and close > open
        q := 3
    else if not na(asr_low) and low < asr_low - sweep_buffer and close > asr_low and close > open
        q := 2
    else if use_pwhl and not na(pwl) and low < pwl - sweep_buffer and close > pwl and close > open
        q := 2
    else if not na(last_swing_low) and low < last_swing_low - sweep_buffer and close > last_swing_low and close > open
        q := 1
    q

f_sweep_bear_quality() =>
    q = 0
    if not na(pdh) and high > pdh + sweep_buffer and close < pdh and close < open
        q := 3
    else if not na(asr_high) and high > asr_high + sweep_buffer and close < asr_high and close < open
        q := 2
    else if use_pwhl and not na(pwh) and high > pwh + sweep_buffer and close < pwh and close < open
        q := 2
    else if not na(last_swing_high) and high > last_swing_high + sweep_buffer and close < last_swing_high and close < open
        q := 1
    q

sweep_bull_quality_now = f_sweep_bull_quality()
sweep_bear_quality_now = f_sweep_bear_quality()

sweep_low_cond  = sweep_bull_quality_now >= 1 and daily_bias_bull
sweep_high_cond = sweep_bear_quality_now >= 1 and daily_bias_bear

var float last_sweep_low_price  = na
var float last_sweep_high_price = na
var int   last_sweep_low_q      = 0
var int   last_sweep_high_q     = 0

if sweep_low_cond
    last_sweep_low_price := low
    last_sweep_low_q     := sweep_bull_quality_now
if sweep_high_cond
    last_sweep_high_price := high
    last_sweep_high_q     := sweep_bear_quality_now

sweep_low_recent  = ta.barssince(sweep_low_cond)  <= sweep_lookback
     and last_sweep_low_q  >= min_sweep_quality
sweep_high_recent = ta.barssince(sweep_high_cond) <= sweep_lookback
     and last_sweep_high_q >= min_sweep_quality

// ============================================================
// SECTION 9 — CHoCH (Change of Character)
// ============================================================
// CHoCH haussier : après un SWEEP_LOW, clôture au-dessus du
//   dernier swing high dans la fenêtre choch_lookback
//   = premier signe que la structure a inversé en haussier
// CHoCH baissier : après un SWEEP_HIGH, clôture en-dessous du
//   dernier swing low dans la fenêtre choch_lookback

choch_ref_high = ta.highest(high, choch_lookback)[1]
choch_ref_low  = ta.lowest(low,  choch_lookback)[1]

// CHoCH haussier (signal d'inversion après sweep low)
choch_bull = sweep_low_recent
     and close > choch_ref_high
     and close[1] <= choch_ref_high
     and daily_bias_bull

// CHoCH baissier (signal d'inversion après sweep high)
choch_bear = sweep_high_recent
     and close < choch_ref_low
     and close[1] >= choch_ref_low
     and daily_bias_bear

// Mémoriser le niveau et le bar du CHoCH confirmé
var float choch_level_bull    = na
var float choch_level_bear    = na
var int   choch_bull_bar      = na
var int   choch_bear_bar      = na

if choch_bull
    choch_level_bull := choch_ref_high
    choch_bull_bar   := bar_index

if choch_bear
    choch_level_bear := choch_ref_low
    choch_bear_bar   := bar_index

// CHoCH actif dans la fenêtre sweep_lookback
choch_bull_active = not na(choch_bull_bar) and (bar_index - choch_bull_bar) <= sweep_lookback
choch_bear_active = not na(choch_bear_bar) and (bar_index - choch_bear_bar) <= sweep_lookback

// Affichage CHoCH
if show_choch and choch_bull
    if show_bos_lines
        line.new(bar_index - 1, choch_ref_high, bar_index, choch_ref_high,
             color=color.new(color.lime, 20), style=line.style_dashed, width=2)
    if show_labels
        label.new(bar_index, low, text="CHoCH ▲",
             style=label.style_label_up,
             color=color.new(color.lime, 10), textcolor=color.white, size=size.small)

if show_choch and choch_bear
    if show_bos_lines
        line.new(bar_index - 1, choch_ref_low, bar_index, choch_ref_low,
             color=color.new(color.red, 20), style=line.style_dashed, width=2)
    if show_labels
        label.new(bar_index, high, text="CHoCH ▼",
             style=label.style_label_down,
             color=color.new(color.red, 10), textcolor=color.white, size=size.small)

// ============================================================
// SECTION 10 — OTE (Optimal Trade Entry) Fibonacci 0.705
// ============================================================
// LONG : move = last_sweep_low_price → choch_level_bull
//   ote_zone_top = choch_level_bull - move_size × ote_fib_top (0.62)
//   ote_zone_bot = choch_level_bull - move_size × ote_fib_bot (0.79)
// SHORT : move = last_sweep_high_price → choch_level_bear
//   ote_zone_bot = choch_level_bear + move_size × ote_fib_top (0.62)
//   ote_zone_top = choch_level_bear + move_size × ote_fib_bot (0.79)

var float ote_bull_top = na
var float ote_bull_bot = na
var float ote_bear_top = na
var float ote_bear_bot = na

// Recalculer la zone OTE à chaque nouveau CHoCH
if choch_bull and not na(last_sweep_low_price)
    move_size    = choch_level_bull - last_sweep_low_price
    ote_bull_top := choch_level_bull - move_size * ote_fib_top
    ote_bull_bot := choch_level_bull - move_size * ote_fib_bot

if choch_bear and not na(last_sweep_high_price)
    move_size    = last_sweep_high_price - choch_level_bear
    ote_bear_bot := choch_level_bear + move_size * ote_fib_top
    ote_bear_top := choch_level_bear + move_size * ote_fib_bot

// Invalider l'OTE si le prix repart dans la direction opposée
// (cassure en-dessous du sweep low invalide l'OTE bull)
if not na(last_sweep_low_price) and close < last_sweep_low_price - sweep_buffer
    ote_bull_top := na
    ote_bull_bot := na
if not na(last_sweep_high_price) and close > last_sweep_high_price + sweep_buffer
    ote_bear_top := na
    ote_bear_bot := na

// Prix dans la zone OTE
in_ote_bull = not na(ote_bull_top) and not na(ote_bull_bot)
     and close <= ote_bull_top and close >= ote_bull_bot

in_ote_bear = not na(ote_bear_top) and not na(ote_bear_bot)
     and close >= ote_bear_bot and close <= ote_bear_top

// Affichage OTE (rectangle doré)
if show_ote and choch_bull and not na(ote_bull_top) and not na(ote_bull_bot)
    box.new(bar_index, ote_bull_top, bar_index + 40, ote_bull_bot,
         border_color=color.new(color.yellow, 30),
         bgcolor=color.new(color.yellow, 82), border_width=1)
    if show_labels
        label.new(bar_index + 20, (ote_bull_top + ote_bull_bot) / 2, text="OTE",
             style=label.style_none, textcolor=color.new(color.yellow, 10), size=size.tiny)

if show_ote and choch_bear and not na(ote_bear_top) and not na(ote_bear_bot)
    box.new(bar_index, ote_bear_top, bar_index + 40, ote_bear_bot,
         border_color=color.new(color.yellow, 30),
         bgcolor=color.new(color.yellow, 82), border_width=1)
    if show_labels
        label.new(bar_index + 20, (ote_bear_top + ote_bear_bot) / 2, text="OTE",
             style=label.style_none, textcolor=color.new(color.yellow, 10), size=size.tiny)

// ============================================================
// SECTION 11 — FAIR VALUE GAP (FVG)
// ============================================================

fvg_impulse  = (high[1] - low[1]) > fvg_atr_mult * atr_14
fvg_bull_new = fvg_impulse and high[2] < low[0]
fvg_bear_new = fvg_impulse and low[2]  > high[0]

var float[] fvg_bull_top = array.new_float(3, na)
var float[] fvg_bull_bot = array.new_float(3, na)
var float[] fvg_bear_top = array.new_float(3, na)
var float[] fvg_bear_bot = array.new_float(3, na)

if fvg_bull_new
    array.set(fvg_bull_top, 2, array.get(fvg_bull_top, 1))
    array.set(fvg_bull_bot, 2, array.get(fvg_bull_bot, 1))
    array.set(fvg_bull_top, 1, array.get(fvg_bull_top, 0))
    array.set(fvg_bull_bot, 1, array.get(fvg_bull_bot, 0))
    array.set(fvg_bull_top, 0, low[0])
    array.set(fvg_bull_bot, 0, high[2])

if fvg_bear_new
    array.set(fvg_bear_top, 2, array.get(fvg_bear_top, 1))
    array.set(fvg_bear_bot, 2, array.get(fvg_bear_bot, 1))
    array.set(fvg_bear_top, 1, array.get(fvg_bear_top, 0))
    array.set(fvg_bear_bot, 1, array.get(fvg_bear_bot, 0))
    array.set(fvg_bear_top, 0, low[2])
    array.set(fvg_bear_bot, 0, high[0])

for i = 0 to 2
    bt  = array.get(fvg_bull_top, i)
    bb  = array.get(fvg_bull_bot, i)
    if not na(bt) and not na(bb) and close < bb
        array.set(fvg_bull_top, i, na)
        array.set(fvg_bull_bot, i, na)
    bt2 = array.get(fvg_bear_top, i)
    bb2 = array.get(fvg_bear_bot, i)
    if not na(bt2) and not na(bb2) and close > bt2
        array.set(fvg_bear_top, i, na)
        array.set(fvg_bear_bot, i, na)

f_price_in_bull_fvg(p) =>
    result = false
    for i = 0 to 2
        bt = array.get(fvg_bull_top, i)
        bb = array.get(fvg_bull_bot, i)
        if not na(bt) and not na(bb) and p >= bb and p <= bt
            result := true
    result

f_price_in_bear_fvg(p) =>
    result = false
    for i = 0 to 2
        bt = array.get(fvg_bear_top, i)
        bb = array.get(fvg_bear_bot, i)
        if not na(bt) and not na(bb) and p >= bb and p <= bt
            result := true
    result

f_bull_fvg_bot() =>
    result = float(na)
    for i = 0 to 2
        bb = array.get(fvg_bull_bot, i)
        if not na(bb) and na(result)
            result := bb
    result

f_bear_fvg_top() =>
    result = float(na)
    for i = 0 to 2
        bt = array.get(fvg_bear_top, i)
        if not na(bt) and na(result)
            result := bt
    result

if show_fvg and fvg_bull_new
    box.new(bar_index - 2, low[0], bar_index + 20, high[2],
         border_color=color.new(color.blue, 60), bgcolor=color.new(color.blue, 80), border_width=1)
    if show_labels
        label.new(bar_index, (low[0] + high[2]) / 2, text="FVG",
             style=label.style_none, textcolor=color.new(color.blue, 20), size=size.tiny)

if show_fvg and fvg_bear_new
    box.new(bar_index - 2, low[2], bar_index + 20, high[0],
         border_color=color.new(color.orange, 60), bgcolor=color.new(color.orange, 80), border_width=1)
    if show_labels
        label.new(bar_index, (low[2] + high[0]) / 2, text="FVG",
             style=label.style_none, textcolor=color.new(color.orange, 20), size=size.tiny)

// ============================================================
// SECTION 12 — ORDER BLOCK INSTITUTIONNEL
// ============================================================

var float[] ob_bull_top = array.new_float(3, na)
var float[] ob_bull_bot = array.new_float(3, na)
var float[] ob_bear_top = array.new_float(3, na)
var float[] ob_bear_bot = array.new_float(3, na)

f_last_bear_candle_inst() =>
    o_val = float(na)
    c_val = float(na)
    for i = 1 to ob_lookback
        body = math.abs(close[i] - open[i])
        if close[i] < open[i] and body > ob_body_atr_mult * atr_14[i]
            o_val := open[i]
            c_val := close[i]
            break
    [o_val, c_val]

f_last_bull_candle_inst() =>
    o_val = float(na)
    c_val = float(na)
    for i = 1 to ob_lookback
        body = math.abs(close[i] - open[i])
        if close[i] > open[i] and body > ob_body_atr_mult * atr_14[i]
            o_val := open[i]
            c_val := close[i]
            break
    [o_val, c_val]

// OB créé sur le CHoCH (pas sur le BOS générique)
if choch_bull
    [ob_open, ob_close] = f_last_bear_candle_inst()
    if not na(ob_open) and not na(ob_close)
        array.set(ob_bull_top, 2, array.get(ob_bull_top, 1))
        array.set(ob_bull_bot, 2, array.get(ob_bull_bot, 1))
        array.set(ob_bull_top, 1, array.get(ob_bull_top, 0))
        array.set(ob_bull_bot, 1, array.get(ob_bull_bot, 0))
        array.set(ob_bull_top, 0, ob_open)
        array.set(ob_bull_bot, 0, ob_close)

if choch_bear
    [ob_open, ob_close] = f_last_bull_candle_inst()
    if not na(ob_open) and not na(ob_close)
        array.set(ob_bear_top, 2, array.get(ob_bear_top, 1))
        array.set(ob_bear_bot, 2, array.get(ob_bear_bot, 1))
        array.set(ob_bear_top, 1, array.get(ob_bear_top, 0))
        array.set(ob_bear_bot, 1, array.get(ob_bear_bot, 0))
        array.set(ob_bear_top, 0, ob_close)
        array.set(ob_bear_bot, 0, ob_open)

for i = 0 to 2
    bt  = array.get(ob_bull_top, i)
    bb  = array.get(ob_bull_bot, i)
    if not na(bt) and not na(bb) and close < bb
        array.set(ob_bull_top, i, na)
        array.set(ob_bull_bot, i, na)
    bt2 = array.get(ob_bear_top, i)
    bb2 = array.get(ob_bear_bot, i)
    if not na(bt2) and not na(bb2) and close > bt2
        array.set(ob_bear_top, i, na)
        array.set(ob_bear_bot, i, na)

f_price_in_bull_ob(p) =>
    result = false
    for i = 0 to 2
        bt = array.get(ob_bull_top, i)
        bb = array.get(ob_bull_bot, i)
        if not na(bt) and not na(bb) and p >= bb and p <= bt
            result := true
    result

f_price_in_bear_ob(p) =>
    result = false
    for i = 0 to 2
        bt = array.get(ob_bear_top, i)
        bb = array.get(ob_bear_bot, i)
        if not na(bt) and not na(bb) and p >= bb and p <= bt
            result := true
    result

f_bull_ob_bot() =>
    result = float(na)
    for i = 0 to 2
        bb = array.get(ob_bull_bot, i)
        if not na(bb) and na(result)
            result := bb
    result

f_bear_ob_top() =>
    result = float(na)
    for i = 0 to 2
        bt = array.get(ob_bear_top, i)
        if not na(bt) and na(result)
            result := bt
    result

if show_ob and choch_bull
    ob_t = array.get(ob_bull_top, 0)
    ob_b = array.get(ob_bull_bot, 0)
    if not na(ob_t) and not na(ob_b)
        box.new(bar_index - ob_lookback, ob_t, bar_index + 30, ob_b,
             border_color=color.new(color.green, 40), bgcolor=color.new(color.green, 75), border_width=1)
        if show_labels
            label.new(bar_index, (ob_t + ob_b) / 2, text="OB",
                 style=label.style_none, textcolor=color.new(color.green, 20), size=size.tiny)

if show_ob and choch_bear
    ob_t = array.get(ob_bear_top, 0)
    ob_b = array.get(ob_bear_bot, 0)
    if not na(ob_t) and not na(ob_b)
        box.new(bar_index - ob_lookback, ob_t, bar_index + 30, ob_b,
             border_color=color.new(color.red, 40), bgcolor=color.new(color.red, 75), border_width=1)
        if show_labels
            label.new(bar_index, (ob_t + ob_b) / 2, text="OB",
                 style=label.style_none, textcolor=color.new(color.red, 20), size=size.tiny)

// ============================================================
// SECTION 13 — SIGNAUX D'ENTRÉE V6 (6 ÉTAPES)
// ============================================================
// LONG :
//   1. Daily Bias BULL
//   2. Killzone ICT active
//   3. Sweep institutionnel >= qualité 2 dans sweep_lookback
//   4. CHoCH haussier confirmé (inversion de structure)
//   5. Prix dans la zone OTE (retracement 62-79%)
//   6. Confluence : OTE chevauche FVG haussier OU OB haussier
// SHORT : symétrique

in_killzone  = f_in_killzone()
in_bull_zone = f_price_in_bull_fvg(close) or f_price_in_bull_ob(close)
in_bear_zone = f_price_in_bear_fvg(close) or f_price_in_bear_ob(close)

discount_ok_long  = not use_discount_filter or in_discount
discount_ok_short = not use_discount_filter or in_premium

long_signal = choch_bull_active
     and in_ote_bull
     and in_bull_zone
     and discount_ok_long
     and in_killzone
     and daily_bias_bull
     and strategy.position_size == 0

short_signal = choch_bear_active
     and in_ote_bear
     and in_bear_zone
     and discount_ok_short
     and in_killzone
     and daily_bias_bear
     and strategy.position_size == 0

// ============================================================
// SECTION 14 — SL DYNAMIQUE
// ============================================================
// Priorité : sous sweep low > sous OB > sous FVG > fallback 20p

f_sl_long() =>
    ob_bot  = f_bull_ob_bot()
    fvg_bot = f_bull_fvg_bot()
    sl_raw  = float(na)
    if not na(last_sweep_low_price)
        sl_raw := last_sweep_low_price - f_pips_to_price(2.0)
    else if not na(ob_bot)
        sl_raw := ob_bot - f_pips_to_price(2.0)
    else if not na(fvg_bot)
        sl_raw := fvg_bot - f_pips_to_price(2.0)
    else
        sl_raw := close - f_pips_to_price(20.0)
    sl_pips_calc    = f_price_to_pips(close - sl_raw)
    sl_pips_clamped = f_clamp(sl_pips_calc, sl_min_pips, sl_max_pips)
    close - f_pips_to_price(sl_pips_clamped)

f_sl_short() =>
    ob_top  = f_bear_ob_top()
    fvg_top = f_bear_fvg_top()
    sl_raw  = float(na)
    if not na(last_sweep_high_price)
        sl_raw := last_sweep_high_price + f_pips_to_price(2.0)
    else if not na(ob_top)
        sl_raw := ob_top + f_pips_to_price(2.0)
    else if not na(fvg_top)
        sl_raw := fvg_top + f_pips_to_price(2.0)
    else
        sl_raw := close + f_pips_to_price(20.0)
    sl_pips_calc    = f_price_to_pips(sl_raw - close)
    sl_pips_clamped = f_clamp(sl_pips_calc, sl_min_pips, sl_max_pips)
    close + f_pips_to_price(sl_pips_clamped)

// ============================================================
// SECTION 15 — TP INTELLIGENT
// ============================================================
// Priorité LONG : PDH > OB bear > swing high > RR × 2.5
// Priorité SHORT: PDL > OB bull > swing low  > RR × 2.5

f_tp_long(sl_price) =>
    sl_dist    = close - sl_price
    tp_rr      = close + sl_dist * min_rr
    tp_pdh     = not na(pdh) and pdh > close + sl_dist * min_rr ? pdh : float(na)
    ob_res     = f_bear_ob_top()
    tp_ob      = not na(ob_res) and ob_res > close + sl_dist * min_rr ? ob_res : float(na)
    next_pivot = ta.pivothigh(high, swing_lookback, 0)
    tp_pivot   = not na(next_pivot) and next_pivot > close + sl_dist * min_rr ? next_pivot : float(na)
    if not na(tp_pdh)
        tp_pdh
    else if not na(tp_ob)
        tp_ob
    else if not na(tp_pivot)
        tp_pivot
    else
        tp_rr

f_tp_short(sl_price) =>
    sl_dist    = sl_price - close
    tp_rr      = close - sl_dist * min_rr
    tp_pdl     = not na(pdl) and pdl < close - sl_dist * min_rr ? pdl : float(na)
    ob_sup     = f_bull_ob_bot()
    tp_ob      = not na(ob_sup) and ob_sup < close - sl_dist * min_rr ? ob_sup : float(na)
    next_pivot = ta.pivotlow(low, swing_lookback, 0)
    tp_pivot   = not na(next_pivot) and next_pivot < close - sl_dist * min_rr ? next_pivot : float(na)
    if not na(tp_pdl)
        tp_pdl
    else if not na(tp_ob)
        tp_ob
    else if not na(tp_pivot)
        tp_pivot
    else
        tp_rr

// ============================================================
// SECTION 16 — ENTRÉES + BREAKEVEN
// ============================================================

var float entry_price_mem   = na
var float sl_initial_pips_m = na
var bool  be_triggered      = false
var float tp_long_mem       = na
var float tp_short_mem      = na

sl_long_price  = f_sl_long()
sl_short_price = f_sl_short()

sl_long_pips  = f_price_to_pips(close - sl_long_price)
sl_short_pips = f_price_to_pips(sl_short_price - close)

sl_long_ok  = sl_long_pips  >= sl_min_pips and sl_long_pips  <= sl_max_pips
sl_short_ok = sl_short_pips >= sl_min_pips and sl_short_pips <= sl_max_pips

tp_long_price  = f_tp_long(sl_long_price)
tp_short_price = f_tp_short(sl_short_price)

rr_long  = sl_long_pips  > 0 ? f_price_to_pips(tp_long_price  - close) / sl_long_pips  : 0.0
rr_short = sl_short_pips > 0 ? f_price_to_pips(close - tp_short_price) / sl_short_pips : 0.0

rr_long_ok  = rr_long  >= min_rr
rr_short_ok = rr_short >= min_rr

// — ENTRÉE LONG —
if long_signal and sl_long_ok and rr_long_ok
    entry_price_mem   := close
    sl_initial_pips_m := sl_long_pips
    tp_long_mem       := tp_long_price
    be_triggered      := false
    q_label = last_sweep_low_q == 3 ? "PDL" : last_sweep_low_q == 2 ? "ASR" : "SW"
    strategy.entry("Long", strategy.long)
    strategy.exit("Long TP/SL", from_entry="Long",
         stop=sl_long_price, limit=tp_long_price)
    if show_labels
        label.new(bar_index, low,
             text  = "L [" + q_label + "]  SL:" + str.tostring(math.round(sl_long_pips, 1)) + "p  RR:" + str.tostring(math.round(rr_long, 1)),
             style = label.style_label_up,
             color = color.new(color.teal, 10), textcolor=color.white, size=size.tiny)

// — ENTRÉE SHORT —
if short_signal and sl_short_ok and rr_short_ok
    entry_price_mem   := close
    sl_initial_pips_m := sl_short_pips
    tp_short_mem      := tp_short_price
    be_triggered      := false
    q_label = last_sweep_high_q == 3 ? "PDH" : last_sweep_high_q == 2 ? "ASR" : "SW"
    strategy.entry("Short", strategy.short)
    strategy.exit("Short TP/SL", from_entry="Short",
         stop=sl_short_price, limit=tp_short_price)
    if show_labels
        label.new(bar_index, high,
             text  = "S [" + q_label + "]  SL:" + str.tostring(math.round(sl_short_pips, 1)) + "p  RR:" + str.tostring(math.round(rr_short, 1)),
             style = label.style_label_down,
             color = color.new(color.maroon, 10), textcolor=color.white, size=size.tiny)

// — BREAKEVEN À +1R —
if use_breakeven and not be_triggered and not na(entry_price_mem) and not na(sl_initial_pips_m)
    if strategy.position_size > 0
        profit_pips = f_price_to_pips(high - entry_price_mem)
        if profit_pips >= sl_initial_pips_m
            be_triggered := true
            strategy.exit("Long TP/SL", from_entry="Long",
                 stop = entry_price_mem + f_pips_to_price(1.0),
                 limit = tp_long_mem)
    else if strategy.position_size < 0
        profit_pips = f_price_to_pips(entry_price_mem - low)
        if profit_pips >= sl_initial_pips_m
            be_triggered := true
            strategy.exit("Short TP/SL", from_entry="Short",
                 stop = entry_price_mem - f_pips_to_price(1.0),
                 limit = tp_short_mem)

if strategy.position_size == 0
    entry_price_mem   := na
    sl_initial_pips_m := na
    be_triggered      := false
    tp_long_mem       := na
    tp_short_mem      := na

// ============================================================
// SECTION 17 — TABLEAU RÉCAPITULATIF
// ============================================================

var table stats_table = table.new(
     position.top_right, 2, 8,
     bgcolor      = color.new(color.black, 20),
     border_width = 1,
     border_color = color.new(color.gray, 50)
 )

if barstate.islast and show_table
    total_trades  = strategy.closedtrades
    winning       = strategy.wintrades
    winrate       = total_trades > 0 ? math.round(winning / total_trades * 100, 1) : 0.0
    gross_profit  = strategy.grossprofit
    gross_loss    = math.abs(strategy.grossloss)
    profit_factor = gross_loss > 0 ? math.round(gross_profit / gross_loss, 2) : 0.0
    net_pnl       = strategy.netprofit
    avg_win       = winning > 0 ? gross_profit / winning : 0.0
    avg_loss      = (total_trades - winning) > 0 ? gross_loss / (total_trades - winning) : 1.0
    rr_real       = avg_loss > 0 ? math.round(avg_win / avg_loss, 2) : 0.0
    max_dd        = math.round(strategy.max_drawdown / strategy.initial_capital * 100, 1)
    choch_active  = choch_bull_active or choch_bear_active

    table.cell(stats_table, 0, 0, "SMC Strategy v6",
         text_color=color.white, text_halign=text.align_left,
         bgcolor=color.new(color.navy, 20), text_size=size.small)
    table.cell(stats_table, 1, 0, "ICT / OTE",
         text_color=color.white, text_halign=text.align_right,
         bgcolor=color.new(color.navy, 20), text_size=size.small)

    table.cell(stats_table, 0, 1, "Trades",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 1, str.tostring(total_trades),
         text_color=total_trades >= 20 ? color.green : color.yellow,
         text_halign=text.align_right, text_size=size.small)

    table.cell(stats_table, 0, 2, "Winrate",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 2, str.tostring(winrate) + " %",
         text_color=winrate >= 35 ? color.green : color.red,
         text_halign=text.align_right, text_size=size.small)

    table.cell(stats_table, 0, 3, "Profit Factor",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 3, str.tostring(profit_factor),
         text_color=profit_factor >= 1.2 ? color.green : profit_factor >= 1.0 ? color.yellow : color.red,
         text_halign=text.align_right, text_size=size.small)

    table.cell(stats_table, 0, 4, "RR Moyen",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 4, "1:" + str.tostring(rr_real),
         text_color=rr_real >= 2.5 ? color.green : color.yellow,
         text_halign=text.align_right, text_size=size.small)

    table.cell(stats_table, 0, 5, "Net PnL",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 5, str.tostring(math.round(net_pnl, 2)) + " $",
         text_color=net_pnl >= 0 ? color.green : color.red,
         text_halign=text.align_right, text_size=size.small)

    table.cell(stats_table, 0, 6, "Max Drawdown",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 6, str.tostring(max_dd) + " %",
         text_color=max_dd <= 15 ? color.green : max_dd <= 25 ? color.yellow : color.red,
         text_halign=text.align_right, text_size=size.small)

    table.cell(stats_table, 0, 7, "Biais Daily",
         text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(stats_table, 1, 7, daily_bias_bull ? "BULL" : "BEAR",
         text_color=daily_bias_bull ? color.green : color.red,
         text_halign=text.align_right, text_size=size.small)
