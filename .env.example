# ============================================================
# SMC Trading Bot — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# ============================================================

# --- Telegram ---
# Token du bot Telegram (via @BotFather)
TELEGRAM_BOT_TOKEN=

# ID du chat où envoyer les notifications (via @userinfobot)
TELEGRAM_CHAT_ID=

# --- PineConnector ---
# Identifiant de licence PineConnector
PINECONNECTOR_LICENSE_ID=

# --- Sécurité Webhook ---
# Clé secrète partagée avec TradingView pour authentifier les webhooks
WEBHOOK_SECRET_KEY=

# --- Infrastructure VPS ---
# Adresse IP ou domaine du VPS
VPS_HOST=

# --- Logging ---
# Niveau de log : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
